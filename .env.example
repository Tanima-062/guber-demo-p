PROXY_ENABLED=true
PROXY_HOST=brd.superproxy.io
PROXY_PORT=44445
PROXY_USERNAME=
PROXY_PASSWORD=

# Scraper behaviour
REQUEST_DELAY_MS=1500
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=2
USE_BROWSER_ON_403=true

# File paths
INPUT_FILE=data/items.csv
OUTPUT_FILE=output/output.json
FAILURE_FILE=output/output.failures.json
